{
  "expo": {
    "name": "Worthi 2.0",
    "slug": "worthi",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon-final.png",
    "scheme": "worthi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon-final.icon",
      "buildNumber": "3",
      "bundleIdentifier": "com.alastair.r.mcneill.worthi2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundImage": "./assets/icon-background.png",
        "monochromeImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#7EB6FF"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3,
      "package": "com.alastair.r.mcneill.worthi2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "212d3d2a-7121-45ef-8b72-4bad3c30994f"
      }
    }
  }
}
